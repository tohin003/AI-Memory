{
  "manifest_version": 3,
  "name": "AI Memory Collector",
  "version": "1.0.0",
  "description": "A privacy-first Chrome extension that creates a unified memory across ChatGPT, Gemini, Claude, Perplexity, and more — entirely offline.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ],
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo128.png"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://www.perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Memory Collector",
    "default_icon": {
      "16": "logo16.png",
      "48": "logo48.png",
      "128": "logo128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-scripts/chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content-scripts/gemini.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content-scripts/claude.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "content-scripts/perplexity.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-scripts/fallback.js",
        "content-scripts/injector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "inject_context": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Inject AI Memory Context"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "storage/sqlite/sqlite.wasm",
        "storage/sqlite/hnsw.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}